<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="54dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/rank_place"
        style="@style/RankPlaceColumn"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rank_name"
        style="@style/RankNameColumn"
        android:ellipsize="end"
        android:maxLines="2" />

    <TextView
        android:id="@+id/rank_points"
        style="@style/RankPointsColumn"
        android:layout_height="48dp"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rank_time"
        style="@style/RankTimeColumn"
        android:textColor="@color/rank_muted" />

    <Button
        android:id="@+id/rank_delete"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="@dimen/rank_delete_width"
        android:layout_height="48dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="@string/ranking_delete_symbol"
        android:textColor="@color/rank_delete"
        android:textSize="25sp" />
</LinearLayout>
