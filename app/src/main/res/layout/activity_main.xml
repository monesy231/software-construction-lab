<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/difficulty_menu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="106dp"
            android:layout_height="106dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/hero" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityHeading="true"
            android:text="@string/menu_title"
            android:textColor="#F1F7FF"
            android:textSize="38sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/menu_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:accessibilityHeading="true"
                android:text="@string/select_difficulty"
                android:textColor="#C7DAF2"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/start_easy"
                style="@style/DifficultyButton"
                android:text="@string/difficulty_easy" />

            <Button
                android:id="@+id/start_normal"
                style="@style/DifficultyButton"
                android:layout_marginTop="8dp"
                android:text="@string/difficulty_normal" />

            <Button
                android:id="@+id/start_hard"
                style="@style/DifficultyButton"
                android:layout_marginTop="8dp"
                android:text="@string/difficulty_hard" />

            <Button
                android:id="@+id/open_rankings"
                style="@style/DifficultyButton"
                android:layout_marginTop="8dp"
                android:text="@string/ranking_title" />

            <Switch
                android:id="@+id/audio_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:switchPadding="12dp"
                android:text="@string/audio_switch"
                android:textColor="#C7DAF2"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
